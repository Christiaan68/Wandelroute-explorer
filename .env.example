# Wandelroute Explorer — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul echte waarden in.
# Zet .env.local NOOIT in git (staat al in .gitignore).

# --- Routingprovider ---------------------------------------------------
# Welke adapter src/lib/routing/index.ts moet gebruiken. Op dit moment is
# alleen "ors" (OpenRouteService) volledig geïmplementeerd.
ROUTING_PROVIDER=ors

# Gratis API-key aanvragen op https://openrouteservice.org/dev/#/signup
# (kies "Free" plan — 2000 requests/dag is ruim voldoende om mee te testen).
# Dit is een SERVER-side variabele (geen NEXT_PUBLIC_ prefix): de key wordt
# nooit naar de browser gestuurd, alle routing-calls lopen via onze eigen
# API-routes (src/app/api/route/generate).
ORS_API_KEY=your_openrouteservice_api_key_here

# --- Kaartweergave -------------------------------------------------------
# Welke kaart getoond wordt:
#   osm          = standaardkaart van openstreetmap.org (standaard; toont kleine
#                  paden en stoplichten/kruispunten, gratis, geen key)
#   openfreemap  = vorige kaart (vector tiles van OpenFreeMap, gratis, geen key)
# Leeg laten = osm. TERUGDRAAIEN naar de oude kaart: zet dit op openfreemap
# (lokaal in .env.local en in Vercel) en deploy opnieuw — geen codewijziging nodig.
NEXT_PUBLIC_MAP_PROVIDER=

# Alleen gebruikt als NEXT_PUBLIC_MAP_PROVIDER=openfreemap: MapLibre-stijl-URL.
# Wijzig alleen als je een andere OpenFreeMap-stijl (bv. .../styles/bright) of
# een eigen tile-provider wilt gebruiken.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Geocoding -----------------------------------------------------------
# Adres-zoekfunctie gebruikt Nominatim (OpenStreetMap), gratis en zonder key.
# Vereist een geldig contact-e-mailadres in de User-Agent conform het
# Nominatim-gebruiksbeleid (https://operations.osmfoundation.org/policies/nominatim/).
NOMINATIM_CONTACT_EMAIL=jouw-email@voorbeeld.nl

# --- Analytics -------------------------------------------------------------
# Measurement ID van een Google Analytics 4-property (Beheer > Gegevensstromen
# > je webstroom, te vinden boven in dat scherm). Dit is een PUBLIEKE variabele
# (NEXT_PUBLIC_-prefix): hij komt in de browser-JavaScript terecht, dat is voor
# een Measurement ID normaal en geen geheim. Leeg laten = analytics volledig
# uit (geen script, geen toestemmingsbanner). Zelfde waarde voor Development,
# Preview en Production; GA4 heeft geen apart test-/productie-onderscheid
# zoals Mollie.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
